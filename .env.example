# ========================================
# BARBER FLOW - Environment Configuration
# ========================================

# Frontend Configuration (barber-flow-web)
# ========================================
VITE_API_BASE_URL=http://localhost:7016
VITE_API_TIMEOUT=30000
NODE_ENV=development

# Backend Configuration (barber-flow-api)
# ========================================
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080;https://+:8081

# MongoDB Configuration
# ========================================
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=barberflow_2026
MONGO_INITDB_DATABASE=barber-flow-dev-db
MONGODB_URI=mongodb://admin:barberflow_2026@localhost:27017/barber-flow-dev-db

# JWT Configuration
# ========================================
JWT_SECRET=barber_flow_jwt_secret_development_key_change_in_production
JWT_ISSUER=barber-flow-api
JWT_AUDIENCE=barber-flow-web
JWT_EXPIRATION_MINUTES=1440

# CORS Configuration
# ========================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000

# Email Configuration (SMTP)
# ========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@barberflow.com
# SMTP_FROM_NAME=Barber Flow

# Optional Features
# ========================================
# VITE_ANALYTICS_ID=
# ENABLE_SWAGGER=true
# LOG_LEVEL=Information

# Notes:
# - Copy this file to .env.local to override defaults
# - Never commit .env.local or actual passwords
# - Change JWT_SECRET, MongoDB passwords for production
# - Update CORS_ALLOWED_ORIGINS with your domain
